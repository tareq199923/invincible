GATEWAY_API_KEY=            # shared-secret token required for all /v1/* requests
INVINCIBLE_OWNER_SECRET=    # one-time browser login for /oauth/authorize: authenticates you as the owner when approving an MCP client connection. NOT sent on /mcp requests - real /mcp calls use short-lived OAuth Bearer tokens instead.
                            # (legacy MCP_SHARED_SECRET is still read as a fallback; rename it to INVINCIBLE_OWNER_SECRET when you next open this file)
NVIDIA_API_KEY=             # NVIDIA NIM hosted (tier 1): z-ai/glm-5.2
GROQ_API_KEY=               # Groq (tier 2): openai/gpt-oss-120b
OPENROUTER_API_KEY=         # OpenRouter fallback (tier 3)
GEMINI_API_KEY=             # Gemini fallback (tier 4, last resort)
# INVINCIBLE_READ_ROOTS=    # optional: extra directories read_file may access, separated by ';' (Windows) or ':' (Unix). The repo root and the server's working directory are always allowed.