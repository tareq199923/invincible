INVINCIBLE_DB_URL=          # PostgreSQL DSN (required): postgresql://user:pass@host:5432/invincible
INVINCIBLE_OWNER_SECRET=    # signs account browser sessions (dashboard login, OAuth consent). Unset = browser sessions fail closed. NOT sent on /mcp requests - real /mcp calls use short-lived OAuth Bearer tokens.
                            # (legacy MCP_SHARED_SECRET is still read as a fallback; rename it to INVINCIBLE_OWNER_SECRET when you next open this file)
INVINCIBLE_CREDENTIAL_KEY=  # Fernet master key encrypting stored BYOK provider credentials at rest. Generate with `invincible secret credential-key`. BACK IT UP: losing it makes saved provider keys undecryptable.
# /v1/* requests authenticate with per-user `inv_` API keys (minted in the dashboard at /account or via `invincible api-key create`) - there is no shared gateway key.
# Each user connects their own provider keys on the dashboard's Providers page (BYOK) and routes only through them.
# Remote / multi-user deployments: docs/DEPLOYMENT.md is the required-env checklist.
# INVINCIBLE_AGENT_ROUTING=1             # REQUIRED on public multi-user deployments: confirmed tool calls run on each user's own paired agent, never the server host.
# INVINCIBLE_PERSIST_PENDING_ACTIONS=1   # optional: staged approvals survive a restart instead of being orphaned.
# INVINCIBLE_MIGRATE_DB_URL=             # optional: schema-owner DSN used only for the image's startup `db upgrade` (container/platform deploys).
# INVINCIBLE_READ_ROOTS=    # optional: extra directories read_file may access, separated by ';' (Windows) or ':' (Unix). The repo root and the server's working directory are always allowed.
# INVINCIBLE_TUNNEL_NAME=invincible   # optional: Cloudflare tunnel name used by `inv start` (override with --tunnel-name)
